{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tet-tet/kaarten.schema.json",
  "title": "Tet Tet-kaarten",
  "description": "Schema voor alle kaarttypes. Verplichte velden zijn vast; alles onder 'kenmerken' is vrij uit te breiden. Onbekende extra velden zijn toegestaan.",
  "$defs": {
    "basis": {
      "type": "object",
      "required": [
        "id",
        "type",
        "versie",
        "status",
        "eigenaar",
        "goedgekeurd_door",
        "geldig_vanaf",
        "kenmerken"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "versie": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "status": {
          "enum": [
            "concept",
            "actief",
            "vervangen"
          ]
        },
        "eigenaar": {
          "type": "string"
        },
        "goedgekeurd_door": {
          "type": "string"
        },
        "geldig_vanaf": {
          "type": "string",
          "format": "date"
        },
        "kenmerken": {
          "type": "object"
        }
      }
    },
    "afdeling_id": {
      "enum": [
        "ops",
        "fin",
        "mkt",
        "rnd",
        "hr",
        "risk",
        "prod"
      ]
    },
    "tekstlijst": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "recht": {
      "enum": [
        "r",
        "rw"
      ]
    }
  },
  "oneOf": [
    {
      "title": "Cultuurkaart organisatie",
      "allOf": [
        {
          "$ref": "#/$defs/basis"
        }
      ],
      "properties": {
        "type": {
          "const": "cultuurkaart_organisatie"
        },
        "missie": {
          "type": "string"
        },
        "kernwaarden": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "naam",
              "betekenis"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "naam": {
                "type": "string"
              },
              "betekenis": {
                "type": "string"
              },
              "we_doen": {
                "type": "array"
              },
              "we_doen_niet": {
                "type": "array"
              }
            }
          }
        },
        "edge_principes": {
          "type": "array"
        },
        "toon": {
          "type": "object"
        },
        "beslisprincipes": {
          "$ref": "#/$defs/tekstlijst"
        },
        "rode_lijnen": {
          "$ref": "#/$defs/tekstlijst"
        },
        "connectors": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/recht"
          },
          "description": "Connectors van de directie (afdeling centraal)."
        }
      },
      "required": [
        "type",
        "missie",
        "kernwaarden",
        "rode_lijnen"
      ]
    },
    {
      "title": "Cultuurkaart afdeling",
      "allOf": [
        {
          "$ref": "#/$defs/basis"
        }
      ],
      "properties": {
        "type": {
          "const": "cultuurkaart_afdeling"
        },
        "afdeling": {
          "$ref": "#/$defs/afdeling_id"
        },
        "erft_van": {
          "type": "string"
        },
        "missie": {
          "type": "string"
        },
        "accent_op": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "waarden": {
          "$ref": "#/$defs/tekstlijst"
        },
        "werkwijze": {
          "$ref": "#/$defs/tekstlijst"
        },
        "edge_principes": {
          "type": "array"
        },
        "kwaliteitsnorm": {
          "type": "string"
        },
        "connectors": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/recht"
          },
          "description": "Connectors waarmee deze afdeling werkt (id uit het connectorregister -> r of rw). Alle agents van de afdeling erven ze."
        }
      },
      "required": [
        "type",
        "afdeling",
        "erft_van",
        "missie",
        "waarden",
        "werkwijze"
      ]
    },
    {
      "title": "Profielkaart agent",
      "allOf": [
        {
          "$ref": "#/$defs/basis"
        }
      ],
      "properties": {
        "type": {
          "const": "profielkaart"
        },
        "naam": {
          "type": "string"
        },
        "rol": {
          "enum": [
            "oppertet",
            "assistent_oppertet",
            "hoofdtet",
            "tet",
            "controltet"
          ]
        },
        "rolkaart": {
          "type": "string"
        },
        "afdeling": {
          "anyOf": [
            {
              "$ref": "#/$defs/afdeling_id"
            },
            {
              "const": "centraal"
            }
          ]
        },
        "erft_van": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "rapporteert_aan": {
          "type": "string"
        },
        "missie": {
          "type": "string"
        },
        "werkstijl": {
          "type": "object"
        },
        "autonomieniveau": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4
        },
        "mandaat": {
          "type": "object",
          "required": [
            "toegangskaart",
            "inperkingen"
          ],
          "properties": {
            "toegangskaart": {
              "type": "string"
            },
            "inperkingen": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "extra_connectors": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "connector",
                  "recht",
                  "reden",
                  "goedgekeurd_door"
                ],
                "properties": {
                  "connector": {
                    "type": "string"
                  },
                  "recht": {
                    "$ref": "#/$defs/recht"
                  },
                  "reden": {
                    "type": "string",
                    "minLength": 3
                  },
                  "goedgekeurd_door": {
                    "const": "raad"
                  }
                }
              },
              "description": "Uitzondering voor deze agent: een connector die alleen andere afdelingen hebben. Alleen met akkoord van de Raad; nooit ruimer dan die afdelingen."
            }
          }
        },
        "budget": {
          "type": "object"
        },
        "samenwerking": {
          "type": "object"
        },
        "meetwaarden": {
          "type": "object"
        },
        "inzet": {
          "enum": [
            "actief",
            "gepland"
          ],
          "description": "gepland = kaart klaar, agent nog niet ingezet (activeren door de Raad na meting)"
        }
      },
      "required": [
        "type",
        "naam",
        "rol",
        "rolkaart",
        "afdeling",
        "erft_van",
        "rapporteert_aan",
        "missie",
        "autonomieniveau",
        "mandaat"
      ]
    },
    {
      "title": "Rolkaart",
      "allOf": [
        {
          "$ref": "#/$defs/basis"
        }
      ],
      "properties": {
        "type": {
          "const": "rolkaart"
        },
        "bereik": {
          "enum": [
            "organisatie",
            "eigen_afdeling",
            "eigen_taak"
          ]
        },
        "max_autonomieniveau": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4
        },
        "mag": {
          "$ref": "#/$defs/tekstlijst"
        },
        "mag_niet": {
          "$ref": "#/$defs/tekstlijst"
        },
        "niveau": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9,
          "description": "Rangorde in de lijn: 1 = hoogst (onder de Raad). Wie aan iemand rapporteert, heeft een hoger getal dan die ander."
        },
        "voorbehouden": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Handelingen die alleen deze rol (en de Raad) mag; geen rol met een hoger niveaugetal mag ze in 'mag' hebben."
        }
      },
      "required": [
        "type",
        "naam",
        "bereik",
        "max_autonomieniveau",
        "mag",
        "mag_niet",
        "niveau"
      ]
    },
    {
      "title": "Toegangskaart afdeling",
      "allOf": [
        {
          "$ref": "#/$defs/basis"
        }
      ],
      "properties": {
        "type": {
          "const": "toegangskaart_afdeling"
        },
        "afdeling": {
          "anyOf": [
            {
              "$ref": "#/$defs/afdeling_id"
            },
            {
              "const": "centraal"
            }
          ]
        },
        "intern": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/recht"
          },
          "description": "Interne systemen en ingebouwde tools. Connectors staan op de cultuurkaart van de afdeling."
        }
      },
      "required": [
        "type",
        "afdeling",
        "intern"
      ]
    },
    {
      "title": "Connectorregister",
      "allOf": [
        {
          "$ref": "#/$defs/basis"
        }
      ],
      "properties": {
        "type": {
          "const": "connectorregister"
        },
        "connectors": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "naam",
              "verbonden"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z_]+$"
              },
              "naam": {
                "type": "string"
              },
              "soort": {
                "type": "string"
              },
              "verbonden": {
                "type": "boolean"
              },
              "tools": {
                "type": "string"
              },
              "spelregel": {
                "type": "string"
              },
              "gevoelig": {
                "type": "boolean"
              },
              "mono": {
                "type": "string"
              },
              "kleur": {
                "type": "string"
              }
            }
          }
        }
      },
      "required": [
        "type",
        "connectors"
      ]
    },
    {
      "title": "Handboek – werkwijze",
      "allOf": [
        {
          "$ref": "#/$defs/basis"
        }
      ],
      "properties": {
        "type": {
          "const": "handboek"
        },
        "onderdeel": {
          "const": "werkwijze"
        },
        "documentsoort": {
          "enum": [
            "leren",
            "handleiding",
            "naslag",
            "uitleg"
          ]
        },
        "stappen": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "stap",
              "regel"
            ]
          }
        }
      },
      "required": [
        "type",
        "onderdeel",
        "documentsoort",
        "stappen",
        "wijzigen"
      ]
    },
    {
      "title": "Handboek – schrijfstijl",
      "allOf": [
        {
          "$ref": "#/$defs/basis"
        }
      ],
      "properties": {
        "type": {
          "const": "handboek"
        },
        "onderdeel": {
          "const": "schrijfstijl"
        },
        "documentsoort": {
          "enum": [
            "leren",
            "handleiding",
            "naslag",
            "uitleg"
          ]
        },
        "regels": {
          "type": "object",
          "required": [
            "max_zinslengte"
          ],
          "properties": {
            "max_zinslengte": {
              "type": "integer",
              "minimum": 5
            }
          }
        },
        "weging": {
          "type": "object"
        }
      },
      "required": [
        "type",
        "onderdeel",
        "documentsoort",
        "toon",
        "regels",
        "weging"
      ]
    },
    {
      "title": "Handboek – woordenlijst",
      "allOf": [
        {
          "$ref": "#/$defs/basis"
        }
      ],
      "properties": {
        "type": {
          "const": "handboek"
        },
        "onderdeel": {
          "const": "woordenlijst"
        },
        "documentsoort": {
          "enum": [
            "leren",
            "handleiding",
            "naslag",
            "uitleg"
          ]
        },
        "opvulling": {
          "$ref": "#/$defs/tekstlijst"
        },
        "engels": {
          "type": "object"
        }
      },
      "required": [
        "type",
        "onderdeel",
        "documentsoort",
        "vaste_namen",
        "opvulling",
        "engels"
      ]
    },
    {
      "title": "Handboek – huisstijl",
      "allOf": [
        {
          "$ref": "#/$defs/basis"
        }
      ],
      "properties": {
        "type": {
          "const": "handboek"
        },
        "onderdeel": {
          "const": "huisstijl"
        },
        "documentsoort": {
          "enum": [
            "leren",
            "handleiding",
            "naslag",
            "uitleg"
          ]
        },
        "kleuren": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          }
        },
        "afdelingen": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          }
        }
      },
      "required": [
        "type",
        "onderdeel",
        "documentsoort",
        "kleuren",
        "afdelingen",
        "typografie"
      ]
    },
    {
      "title": "Handboek – mappenstructuur",
      "allOf": [
        {
          "$ref": "#/$defs/basis"
        }
      ],
      "properties": {
        "type": {
          "const": "handboek"
        },
        "onderdeel": {
          "const": "mappenstructuur"
        },
        "documentsoort": {
          "enum": [
            "leren",
            "handleiding",
            "naslag",
            "uitleg"
          ]
        },
        "mappen": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "pad",
              "waarom",
              "patronen"
            ]
          }
        }
      },
      "required": [
        "type",
        "onderdeel",
        "documentsoort",
        "basis",
        "mappen"
      ]
    },
    {
      "title": "Ijkset",
      "allOf": [
        {
          "$ref": "#/$defs/basis"
        }
      ],
      "properties": {
        "type": {
          "const": "ijkset"
        },
        "rol": {
          "type": "string"
        },
        "k": {
          "type": "integer",
          "minimum": 1
        },
        "taken": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "opdracht",
              "controle"
            ]
          }
        }
      },
      "required": [
        "type",
        "rol",
        "k",
        "taken"
      ]
    }
  ]
}
